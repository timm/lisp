-- balsa_eg.yue: the dialog. Experiments, stats and printing;
-- balsa.yue is the model it talks to.
-- usage: yue -c -s *.yue, then
--   luajit balsa_eg.lua [data...]        5x2 xval, 30 trees, 16 bins
--   luajit balsa_eg.lua --replay F.dat   rerun F's recorded folds
-- (c) 2026 Tim Menzies <timm@ieee.org>, MIT license
import floor, sqrt, max from math
b = require "balsa"
import k, srand, shuffle, bisect, csv, Tbl, adds, div,
       forest, votes, aucs from b
fmt = string.format
kl = (row) -> row.kl                    -- the y of every rig here

-------------------------------------------------------------- stats
median = (xs) ->
  ys = [x for x in *xs]
  table.sort ys
  ys[1 + floor #ys / 2]

cohen = (xs, ys) ->
  a = adds xs
  c = adds ys
  sp = sqrt(((a.n - 1) * div(a)^2 + (c.n - 1) * div(c)^2) /
            max(1, a.n + c.n - 2))
  math.abs(a.mu - c.mu) / (sp + 1e-32)

cliffs = (xs, ys) ->                    -- xs, ys sorted
  d = 0
  for x in *xs
    d += bisect(ys, x) - (#ys - bisect ys, x, true)
  math.abs(d) / (#xs * #ys)

ks = (xs, ys) ->                        -- units of the .05 critical
  n, m, d = #xs, #ys, 0
  for v in *{xs, ys}
    for x in *v
      d = max d, math.abs(bisect(xs, x, true) / n -
                          bisect(ys, x, true) / m)
  d / sqrt((n + m) / (n * m))

same = (xs, ys, eps=k.eps) ->
  xs = [x for x in *xs]
  ys = [y for y in *ys]
  table.sort xs
  table.sort ys
  cohen(xs, ys) <= eps and cliffs(xs, ys) <= 0.195 and
                           ks(xs, ys) <= 1.36

rank = (d) ->                           -- {{name, nums}...} -> ranks
  table.sort d, (x, y) -> median(x[2]) < median(y[2])
  r, pool, out = 1, nil, {}
  for kv in *d
    if pool and not same pool, kv[2] then r, pool = r + 1, nil
    pool = pool or {}
    pool[] = x for x in *kv[2]
    out[kv[1]] = r
  out

--------------------------------------------------------------- rigs
xval = (rows, fn, m=5, n=2) ->
  for _ = 1, m
    u = shuffle rows
    for kf = 0, n - 1
      train, test = {}, {}
      for i, row in ipairs u
        if (i - 1) % n == kf then test[] = row else train[] = row
      fn train, test

ens = (sets) ->
  print "#n30 "
  for f in *sets
    tb = Tbl csv "~/gits/moot/classify/#{f}.csv"
    xval tb.rows, (train, test) ->
      t0 = os.clock!
      a = aucs votes(forest(tb, train, kl), test, kl, tb.kn), tb.kn
      io.write fmt "%s|%.3f |%.3f |\n", f, a, os.clock! - t0
      io.flush!

replay = (dat) ->                       -- rerun DAT's recorded folds:
  print "#1:q16 n30 "                   -- 1 tree all-cols, 30 rf
  tb, v, name = nil, nil, nil
  for line in io.lines dat
    continue if line\match "^#"
    f = line\match "^([^|]*)|"
    ids = line\match "|([^|]*)$"
    if f != name
      name = f
      tb = Tbl csv "~/gits/moot/classify/#{f}.csv"
      v = {}                            -- id = 0-based csv row #
      for i, row in ipairs tb.rows
        v[#tb.rows - i] = row
    test, inh = {}, {}
    for s in ids\gmatch "%d+"
      row = v[tonumber(s)]
      test[] = row
      inh[row] = true
    train = [row for row in *tb.rows when not inh[row]]
    aucs_, secs = {}, {}
    for arm in *{{1, false}, {30, true}}
      k.trees, k.rf = arm[1], arm[2]
      t0 = os.clock!
      aucs_[] = aucs votes(forest(tb, train, kl), test, kl, tb.kn),
                     tb.kn
      secs[] = os.clock! - t0
    io.write fmt "%s|%.3f %.3f |%.3f %.3f |%s\n",
                 f, aucs_[1], aucs_[2], secs[1], secs[2], ids
    io.flush!

ENS = {"balance.scale", "blood-transfusion-service-center",
  "breast.w", "diabetes", "ecoli", "glass", "ionosphere", "sonar",
  "vehicle", "wdbc", "vote", "soybean", "tic-tac-toe", "german",
  "car", "solar.flare2", "primary.tumor", "breast.cancer",
  "spect.test", "audiology", "credit.a", "eucalyptus", "ilpd",
  "heart.c", "hepatitis", "colic", "autos", "cylinder.bands",
  "credit.g", "cmc", "hypothyroid", "sick",
  "Internet-Advertisements", "churn", "COMPAS53", "nomao",
  "bank-marketing", "electricity", "adult"}

srand k.seed
if arg[1] == "--replay"
  replay arg[2]
else
  ens #arg > 0 and arg or ENS

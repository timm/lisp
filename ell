#!/usr/bin/env bash
# ell -- my shell.  Just run:  ./ell
[ "$0" = "${BASH_SOURCE[0]}" ] && exec bash --init-file "$0" -i

# Here = the dir holding this file (not the dir you cd to)
Here=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)

export EDITOR="nvim --clean -u $Here/.nvim.lua"
export BASH_SILENCE_DEPRECATION_WARNING=1
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoredups:erasedups
export PATH="$PATH:$HOME/.local/bin"
export LESS=-R                 # let git colors through

# histappend matters: without it, exiting a shell OVERWRITES
# .bash_history, so a second shell eats the first one's.
shopt -s histappend autocd cdspell dirspell globstar checkwinsize

# up-arrow walks only the lines starting with what you typed
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

ls()     { command ls --color "$@"; }
grep()   { command grep --color=auto "$@"; }
vi()     { $EDITOR "$@"; }   # $EDITOR set above
lisp()   { local f=${1%.lisp}; shift
           sbcl --script "$f.lisp" "$@"; }
check()  { sbcl --script "$Here/,/check.lisp" \
                  "${1%.lisp}.lisp"; }
branch() { git branch --show-current 2>/dev/null; }
dirty()  { [ -n "$(git status -s 2>/dev/null)" ] && echo "*"; }
root()   { cd "$(git rev-parse --show-toplevel 2>/dev/null)"; }
usage()  { grep -oE '^[a-z]+\(\)' "$Here/ell" | tr -d '()'; }
pull()   { git pull -q; }
push()   { local msg
           read -rp "Reason? " msg
           git add -A
           git diff-index --quiet HEAD -- \
             || git commit -qm "${msg:-saving}"
           git push -q -u origin HEAD
           git status -sb; }

# Leave these as raw escape codes
bold=$(tput bold)    ; plain=$(tput sgr0)
cyan=$(tput setaf 6) ; yellow=$(tput setaf 3)

# 🧩 parent/dir  branch*  ▶      \[ \] marks zero-width text,
# so bash still counts the line length right.
prompt_above='$(basename "$(dirname "$PWD")")'
prompt_here='/$(basename "$PWD")'
prompt_branch='$(branch)$(dirty)'
prompt_fmt='🧩 \[${bold}${cyan}\]'"$prompt_above$prompt_here"
prompt_fmt+='\[${plain}\] \[${yellow}\]'"$prompt_branch"
prompt_fmt+='\[${plain}\] ▶ '
PROMPT_COMMAND='PS1="'"$prompt_fmt"'"'

printf '%s' "$yellow"; cat <<'GHOST'

 .-.
(o o) 
| O \  there is no escape ...
 \   \   ... from sh ell!
  `~~~' 

GHOST
printf '%s' "$plain"

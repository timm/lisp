## lua.ssh -- a2ps style for this repo's lua
##
## Use:  a2ps -E lua jiffy.lua -o out.ps
##
## Lua 5.1 keywords, plus jiffy.lua's classes (ALLCAPS) and
## their constructors (Camel).

style lua is
written by "Tim Menzies <timm@ieee.org>"
version is 0.1
requires a2ps 4.12i

documentation is
  "Lua, plus this repo's classes: TBL, NUM, SYM, BINS,"
  "RMEANS, NB, BAG, and their constructors Tbl, Num, Sym,"
  "Bins, Rmeans, Nb, Bag."
  ""
  "Highlights (function NAME ...) and (function CLASS:method"
  "...) as labels."
end documentation

alphabets are
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"

case sensitive

keywords in Keyword_strong are
  and, break, do, else, elseif, "end", false, for, function,
  goto, if, "in", local, nil, not, or, repeat, return, then,
  true, until, while
end keywords

keywords in Keyword are
  getmetatable, setmetatable, ipairs, pairs, next, require,
  tonumber, tostring, type, print, pcall, error, assert
end keywords

# the classes, and the constructors that make them
keywords in Label_strong are
  TBL, NUM, SYM, BINS, RMEANS, NB, BAG,
  Tbl, Num, Sym, Bins, Rmeans, Nb, Bag
end keywords

# function NAME, function CLASS:method: NAME is a label
sequences are
  (/(function)/
   /([ \t]+)/
    \1 Keyword_strong, \2 Plain) Label_strong /[ \t(]/ Plain,
  "--" Comment,
  "[[" String "]]",
  C-string
end sequences

end style
